# Variáveis de ambiente do servidor Thaís de Paula Ateliê
# Copie para .env em produção e defina uma chave aleatória de 64 caracteres hexadecimais:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORT=8080
NODE_ENV=development
APP_SECRET_HEX=

# Conexão Supabase PostgreSQL (copie de Project Settings > Database > Connection string)
DATABASE_URL=

# Acesso ao painel /painel-tp/ (administradora única)
# Gere o hash com: npm run admin:hash  (nunca coloque a senha em texto aqui)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Gateway de Pagamento (sandbox_sim | asaas)
PAYMENT_PROVIDER=sandbox_sim
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# Logística e Frete (Motoboy Cambé R$ 10 / Londrina R$ 20 + Transportadora Loggi para demais cidades)
SHIPPING_PROVIDER=sandbox_sim
LOGGI_API_URL=https://api.loggi.com
LOGGI_CLIENT_ID=
LOGGI_CLIENT_SECRET=
LOGGI_COMPANY_ID=
LOGGI_ORIGIN_CEP=86181000
