# Variáveis de ambiente do servidor Thaís de Paula Ateliê
# Copie para .env em produção e defina uma chave aleatória de 64 caracteres hexadecimais:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORT=8080
NODE_ENV=development
APP_SECRET_HEX=

# Conexão Supabase PostgreSQL (copie de Project Settings > Database > Connection string)
DATABASE_URL=

# Acesso ao painel /painel-tp/ (administradora única)
# Gere o hash com: npm run admin:hash  (nunca coloque a senha em texto aqui)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
